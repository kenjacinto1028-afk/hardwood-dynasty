{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the game window may do",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOCUMENT/Pacific Basketball League"
        },
        {
          "path": "$DOCUMENT/Pacific Basketball League/**"
        },
        {
          "path": "$APPDATA/Pacific Basketball League"
        },
        {
          "path": "$APPDATA/Pacific Basketball League/**"
        }
      ]
    }
  ]
}