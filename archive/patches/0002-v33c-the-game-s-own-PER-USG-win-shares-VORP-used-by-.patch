diff --git a/tools/t33c-awards.js b/tools/t33c-awards.js
new file mode 100644
index 0000000..7b15fd2
--- /dev/null
+++ b/tools/t33c-awards.js
@@ -0,0 +1,23 @@
+// v33c award report: SNAP=tools/snap/nba-commish-s10.json.gz OLD=0|1 SEED=21 node tools/t33c-awards.js [seasons]
+// Plays N seasons from a saved league (commissioner flow, as tools/snap-make.js). OLD=1 = the old award scoring (AW_ADV.on = false).
+// Each season prints one "A " JSON line: winners (MVP, DPOY, ROY, 6MOY, MIP) with MPG / GP / PER / WS / BPM, the MVP's WS rank and the
+// DPOY's DWS rank among qualified players, and who the other scoring would have picked (ladder leader) on the same season.
+const N = +process.argv[2] || 10, OLD = process.env.OLD === '1', SNAP = process.env.SNAP || 'tools/snap/nba-commish-s10.json.gz';
+const { run } = require('./snap.js')(process.env.SRC || 'src', +process.env.SEED || 21, SNAP);
+run(`AW_ADV.on = ${!OLD}; var AWR = [];
+(function () { const ca = computeAwards; computeAwards = function (L) {
+  const other = {}; try { AW_ADV.on = !AW_ADV.on; for (const k of ['mvp', 'dpoy', 'roy', 'smoy', 'mip']) { const l = awardLadder(L, k, 1); other[k] = l[0] ? l[0].pid : null; } } finally { AW_ADV.on = !AW_ADV.on; }
+  const r = ca.apply(this, arguments), A = L.awards[L.season], q = awardQual(L);
+  const rank = (pid, f) => { const p = L.players[pid]; if (!p) return null; const v = f(p); return q.filter(x => f(x) > v).length + 1; };
+  const line = pid => { const p = L.players[pid]; if (!p) return null; const s = p.stats.rs; return { n: p.name, pid, age: p.age, ovr: p.ovr, gp: s.gp, mpg: Math.round(s.min / s.gp / 6) / 10, ppg: Math.round(s.pts / s.gp * 10) / 10, per: s.per, ws: s.ws, ws48: s.ws48, bpm: s.bpm, dws: s.dws, tm: L.teams[p.team] ? L.teams[p.team].abbr + ' ' + L.teams[p.team].w + '-' + L.teams[p.team].l : '' }; };
+  const w = {}; for (const k of ['mvp', 'dpoy', 'roy', 'smoy', 'mip']) w[k] = A[k] != null ? line(A[k]) : null;
+  AWR.push({ s: L.season, w, mvpWsRank: A.mvp != null ? rank(A.mvp, p => p.stats.rs.ws || 0) : null, dpoyDwsRank: A.dpoy != null ? rank(A.dpoy, p => p.stats.rs.dws || 0) : null,
+    other, same: Object.fromEntries(Object.keys(other).map(k => [k, other[k] === A[k]])), all1: A.all1.map(id => L.players[id].name), def1: A.def1.map(id => L.players[id].name) });
+  return r; }; })();`);
+const t0 = Date.now();
+for (let y = 1; y <= N; y++) {
+  const r = run(`(function(){ const L = SL; let g = 0; while (L.phase === 'regular' && g++ < 400) simDay(L); processPending(L); startPlayoffs(L); g = 0; while (L.phase === 'playoffs' && g++ < 400) simPlayoffDay(L);
+    startOffseason(L); runLottery(L); startDraft(L); g = 0; while (L.phase === 'off-draft' && g++ < 200) aiDraftPick(L); if (L.phase === 'off-resign') startFA(L); g = 0; while (L.phase === 'off-fa' && g++ < 60) faDay(L); processPending(L); startNewSeason(L);
+    return JSON.stringify(AWR.shift() || null); })()`);
+  console.log('A ' + r); console.error(`season ${y} ${Math.round((Date.now() - t0) / 1000)} s`);
+}
diff --git a/tools/t33c-awsum.py.txt b/tools/t33c-awsum.py.txt
new file mode 100644
index 0000000..74241f5
--- /dev/null
+++ b/tools/t33c-awsum.py.txt
@@ -0,0 +1,22 @@
+# v33c award report: python3 tools/t33c-awsum.py.txt NEW.txt OLD.txt   (lines "A {...}" from tools/t33c-awards.js; OLD = OLD=1 run)
+import json, sys, collections
+def load(f): return [json.loads(l[2:]) for l in open(f) if l.startswith('A ') and l[2:].strip() != 'null']
+K = ['mvp', 'dpoy', 'roy', 'smoy', 'mip']
+def report(rows, tag):
+    print(f'== {tag}: {len(rows)} seasons')
+    for r in rows:
+        w = r['w']
+        f = lambda k: (f"{w[k]['n']} ({w[k]['tm']}, {w[k]['mpg']} mpg, PER {w[k]['per']}, WS {w[k]['ws']}, BPM {w[k]['bpm']}" + (f", DWS {w[k]['dws']}" if k == 'dpoy' else '') + ')') if w.get(k) else '-'
+        print(f"S{r['s']}: MVP {f('mvp')} [WS rank {r['mvpWsRank']}] | DPOY {f('dpoy')} [DWS rank {r['dpoyDwsRank']}] | ROY {w['roy']['n'] if w.get('roy') else '-'} | 6MOY {w['smoy']['n'] if w.get('smoy') else '-'} | MIP {w['mip']['n'] if w.get('mip') else '-'}")
+    n = len(rows)
+    m3 = sum(1 for r in rows if r['mvpWsRank'] and r['mvpWsRank'] <= 3); d5 = sum(1 for r in rows if r['dpoyDwsRank'] and r['dpoyDwsRank'] <= 5)
+    print(f'  MVP top-3 in WS: {m3}/{n} | DPOY top-5 in DWS: {d5}/{n}')
+    for k in K:
+        ws = [r['w'][k] for r in rows if r['w'].get(k)]
+        c = collections.Counter(x['n'] for x in ws); low = [f"{x['n']} {x['mpg']}" for x in ws if x['mpg'] < (30 if k in ('mvp', 'dpoy') else 20)]
+        print(f"  {k}: {len(set(x['n'] for x in ws))} different winners in {len(ws)}; most by one player {max(c.values()) if c else 0} ({c.most_common(1)[0][0] if c else '-'}); min MPG {min((x['mpg'] for x in ws), default=None)}; low-minute winners: {low or 'none'}")
+    agree = {k: sum(1 for r in rows if r['same'].get(k)) for k in K}
+    print('  same winner as the other scoring would pick (ladder leader, same season):', ', '.join(f'{k} {agree[k]}/{n}' for k in K))
+new, old = load(sys.argv[1]), load(sys.argv[2]) if len(sys.argv) > 2 else []
+report(new, 'new scoring (v33c)')
+if old: report(old, 'old scoring (AW_ADV.on = false, same seed, same saved league)')
diff --git a/tools/t33c.js b/tools/t33c.js
new file mode 100644
index 0000000..a8a2b37
--- /dev/null
+++ b/tools/t33c.js
